# Non-secret Docker Compose configuration.
WORKSHOP_IMAGE=openclaw-vsr-workshop:local
BASE_IMAGE=rocm@sha256:81cb82398fd6f1c0d2fff67fd7629867814fdeca5f192119e41024a15eb5bd9d
NODE_IMAGE=node:24.16.0-bookworm-slim
OPENCLAW_VERSION=2026.10.4
SOURCE_REVISION=unavailable

WORKSHOP_UID=1000
WORKSHOP_GID=1000
WORKSPACE_HOST_PATH=/srv/openclaw-vsr-workshop/workspace
JUPYTER_HOST_PORT=8890

AUTO_BASE_URL=https://api.134.199.192.106.sslip.io/v1
AUTO_MODEL=vllm-sr/auto
GLM_BASE_URL=https://api.134.199.192.106.sslip.io/glm/v1
# Leave blank to discover the direct GLM model from /models.
GLM_MODEL=
VLLM_SR_DASHBOARD_URL=

# These are host paths to root-owned files, never secret values.
AUTO_API_KEY_SECRET_FILE=/etc/openclaw-vsr-workshop/auto_api_key
GLM_API_KEY_SECRET_FILE=/etc/openclaw-vsr-workshop/glm_api_key
JUPYTER_TOKEN_SECRET_FILE=/etc/openclaw-vsr-workshop/jupyter_token
